{
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "seaweedfs-sts",
    "signingKey": "__STS_SIGNING_KEY__"
  },
  "providers": [],
  "policy": { "defaultEffect": "Deny" },
  "roles": [
    {
      "roleName": "LakekeeperVended",
      "roleArn": "arn:aws:iam::role/LakekeeperVended",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          { "Effect": "Allow", "Principal": { "AWS": "*" }, "Action": ["sts:AssumeRole"] }
        ]
      },
      "attachedPolicies": ["WarehouseReadWrite"]
    }
  ],
  "policies": [
    {
      "name": "WarehouseReadWrite",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
            "Resource": ["arn:aws:s3:::warehouse", "arn:aws:s3:::warehouse/*"]
          }
        ]
      }
    }
  ]
}
