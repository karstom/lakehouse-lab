jupyter-ai==${JUPYTER_AI_VERSION}
pyspark-client==${PYSPARK_VERSION}
duckdb==${DUCKDB_VERSION}
pyiceberg[pyarrow,duckdb]==${PYICEBERG_VERSION}
trino==${TRINO_PYTHON_VERSION}
dbt-core==${DBT_CORE_VERSION}
dbt-trino==${DBT_TRINO_VERSION}
