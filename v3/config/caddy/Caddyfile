# Lakehouse Lab V3 edge (ADR-005). One site per service under LAB_DOMAIN.
# TLS: Caddy's internal issuer, rooted in the installer-made CA in ${LAB_STATE_DIR}/ca (mounted
# read-only at /etc/caddy/lab-ca). Caddy only derives intermediates and leaf certificates from
# it, so `down -v` never changes the root browsers trust.
# Caddy listens on the same port numbers inside the container as on the host, so URLs are
# identical for browsers and for containers that reach Caddy through its network aliases.
{
	http_port {$LAB_HTTP_PORT}
	https_port {$LAB_HTTPS_PORT}
	local_certs
	skip_install_trust
	# Redirects are explicit (below) so they keep a non-standard HTTPS port.
	auto_https disable_redirects
	pki {
		ca local {
			name "Lakehouse Lab"
			root {
				format pem_file
				cert /etc/caddy/lab-ca/root.crt
				key /etc/caddy/lab-ca/root.key
			}
		}
	}
}

# Plain HTTP: redirect everything to HTTPS on LAB_HTTPS_PORT. (HTTP-only access for
# *.localhost is not offered: the OIDC issuer is always the HTTPS URL.)
http://:{$LAB_HTTP_PORT} {
	redir https://{host}:{$LAB_HTTPS_PORT}{uri} 308
}

(proxy_common) {
	header {
		-Server
	}
}

auth.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy keycloak:8080
}

trino.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy trino:8080
}

catalog.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy lakekeeper:8181
}

# JupyterHub (Phase 2). Workspaces are reached through the hub's proxy; websockets pass through.
jupyter.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy jupyterhub:8000 {
		# configurable-http-proxy (node) closes idle keep-alive connections after 5 s. Drop
		# ours first, so a DELETE/POST is never sent on a connection it is closing (502 EOF;
		# WATCH_V3_CADDY_UPSTREAM_KEEPALIVE_502).
		transport http {
			keepalive 4s
		}
	}
}

# Forward-auth (CONTRACT Phase 3): oauth2-proxy as the Keycloak client `console`.
# Usage: import lab_forward_auth <oauth2-proxy auth URI>, e.g. /oauth2/auth or
# /oauth2/auth?allowed_groups=engineer,lab-admin. oauth2-proxy answers 202 (signed in and
# allowed: the request goes on, with the X-Auth-Request-* identity headers set from its
# answer; Caddy drops client-sent copies), 401 (not signed in: sign in through console.,
# whose cookie covers every lab subdomain, then come back) or 403 (not in an allowed group:
# passed to the browser as is).
(lab_forward_auth) {
	forward_auth oauth2-proxy:4180 {
		uri {args[0]}
		copy_headers X-Auth-Request-User X-Auth-Request-Preferred-Username X-Auth-Request-Email X-Auth-Request-Groups
		@signin status 401
		handle_response @signin {
			redir * https://console.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT}/oauth2/start?rd={scheme}://{hostport}{uri} 302
		}
	}
}

# Lab Console v1 (ADR-010): a static page behind the forward-auth. It asks oauth2-proxy who
# the user is (/oauth2/userinfo) and console-health for /health.json, and shows only the
# tiles the user's groups can reach.
console.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	# oauth2-proxy's own endpoints: sign-in, callback, sign-out, userinfo.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}
	handle {
		import lab_forward_auth /oauth2/auth
		handle /health.json {
			reverse_proxy console-health:8080
		}
		handle {
			header Cache-Control "no-cache"
			root * /srv/console
			# health/ holds console-health's code (mounted there too), not page content.
			file_server {
				hide /srv/console/health
			}
		}
	}
}

# Spark master UI (profile engineer): engineer and lab-admin only; viewer and analyst get 403.
# Without the engineer profile there is no upstream and Caddy answers 502. Caddy reaches the
# master over the internal `spark` network; this route is the ONLY way to any Spark UI (master,
# worker and application UIs are proxied under it; none listens on `lab`, CONTRACT Phase 3).
spark.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	import lab_forward_auth /oauth2/auth?allowed_groups=engineer,lab-admin
	reverse_proxy spark-master:8080 {
		# The Spark UI needs no cookies. The lab's session cookie (several KB) would otherwise
		# be relayed by the master's worker/app proxy and break it (HTTP 502).
		header_up -Cookie
		# Spark's redirects use http:// (it does not know it is behind TLS).
		header_down Location "^http://" "https://"
	}
}

# Airflow (profile engineer). Its own Keycloak login (auth manager); no forward-auth.
airflow.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy airflow-api:8080
}

# Superset (profile full). Its own Keycloak login (FAB OAuth); no forward-auth.
superset.{$LAB_DOMAIN}:{$LAB_HTTPS_PORT} {
	import proxy_common
	reverse_proxy superset:8088
}
