# Airflow for Lakehouse Lab (CONTRACT Phase 3, ADR-009/017): the upstream image + the Keycloak
# auth manager, and a separate virtualenv (/opt/lab/jobs) with the tools the lab DAGs run:
# dbt-trino, the Trino client, papermill + ipykernel and the Spark Connect client. The jobs venv
# is separate so dbt's and Spark's dependencies never change Airflow's own.
# Pins: versions.env only (ADR-012); transitive pins: lock/*.txt (GENERATED by relock.sh).
# DAGs and config are mounted (dags/, config/airflow/), not baked in.
ARG AIRFLOW_VERSION
ARG AIRFLOW_PYTHON
ARG AIRFLOW_IMAGE_DIGEST
FROM apache/airflow:${AIRFLOW_VERSION}-python${AIRFLOW_PYTHON}@${AIRFLOW_IMAGE_DIGEST}
ARG AIRFLOW_VERSION
ARG AIRFLOW_PROVIDERS_KEYCLOAK_VERSION
ARG DBT_CORE_VERSION
ARG DBT_TRINO_VERSION
ARG TRINO_PYTHON_VERSION
ARG PAPERMILL_VERSION
ARG PYSPARK_VERSION
ARG PANDAS_VERSION
ARG PYARROW_VERSION
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false DO_NOT_TRACK=1

# /opt/lab/data is the `airflow-data` volume (task logs, executed notebooks). Created here with
# the airflow user as owner, so Docker copies that ownership into a new, empty named volume.
USER root
RUN mkdir -p /opt/lab/jobs /opt/lab/bin /opt/lab/data/logs /opt/lab/data/notebooks \
 && chown -R airflow:0 /opt/lab \
 && chmod -R g+rwX /opt/lab/data
USER airflow

COPY --chown=airflow:0 requirements.in jobs-requirements.in lock/ /tmp/req/
# Airflow itself is listed in requirements.in, so pip can never replace the base image's Airflow.
RUN pip install -r /tmp/req/requirements.in -c /tmp/req/constraints.txt \
 && pip check
RUN python -m venv /opt/lab/jobs \
 && /opt/lab/jobs/bin/pip install -r /tmp/req/jobs-requirements.in -c /tmp/req/jobs-constraints.txt \
 && /opt/lab/jobs/bin/pip check \
 && /opt/lab/jobs/bin/python -m ipykernel install --prefix /opt/lab/jobs --name python3 \
 && rm -rf /tmp/req

COPY --chmod=0755 bin/ /opt/lab/bin/
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/opt/lab/bin/lab-airflow"]
CMD ["version"]
