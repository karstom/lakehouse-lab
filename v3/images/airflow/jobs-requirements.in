# The /opt/lab/jobs virtualenv: what the lab DAGs run (dbt, Trino, papermill, Spark Connect).
# Same pins as the workspace image (versions.env), so a job behaves like it does in a notebook.
# Transitive pins: lock/jobs-constraints.txt (GENERATED by relock.sh).
dbt-core==${DBT_CORE_VERSION}
dbt-trino==${DBT_TRINO_VERSION}
trino==${TRINO_PYTHON_VERSION}
papermill==${PAPERMILL_VERSION}
ipykernel
pyspark-client==${PYSPARK_VERSION}
pandas==${PANDAS_VERSION}
pyarrow==${PYARROW_VERSION}
