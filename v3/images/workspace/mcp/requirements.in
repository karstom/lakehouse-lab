# The workspace's MCP venv (/opt/lakehouse/mcp/venv), separate from the notebook environment so
# dbt-mcp's exact pins never change what learners import. pip expands the ${VARS} from the build
# args (versions.env); transitive pins: lock/constraints.txt (GENERATED by relock.sh).
dbt-mcp==${DBT_MCP_VERSION}
mcp==${MCP_SDK_VERSION}
trino==${TRINO_PYTHON_VERSION}
sqlglot==${SQLGLOT_VERSION}
