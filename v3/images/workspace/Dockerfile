# lakehouse-workspace: the per-user container JupyterHub spawns (ADR-007, CONTRACT Phase 2).
# Productionized from spike S-4. Every version arrives as a build arg from versions.env; there
# are no version literals here. Build context: images/workspace. The starter project comes
# from the named build context `starter` (compose: additional_contexts), so the v3/ dir with
# .env/.secrets.env/state never enters a build context.
ARG PYTHON_IMAGE_TAG
ARG PYTHON_IMAGE_DIGEST
# Base pinned by tag AND digest (ADR-012), so apt packages and pip/setuptools/wheel are fixed too.
FROM python:${PYTHON_IMAGE_TAG}@${PYTHON_IMAGE_DIGEST}

ARG JUPYTERHUB_VERSION
ARG JUPYTERLAB_VERSION
ARG IPYKERNEL_VERSION
ARG JUPYSQL_VERSION
ARG JUPYTERLAB_GIT_VERSION
ARG JUPYTER_SERVER_PROXY_VERSION
ARG JUPYTER_AI_VERSION
ARG PYSPARK_VERSION
ARG DUCKDB_VERSION
ARG PYICEBERG_VERSION
ARG TRINO_PYTHON_VERSION
ARG DBT_CORE_VERSION
ARG DBT_TRINO_VERSION
ARG CODE_SERVER_VERSION
# Claude Code is NOT installed here (proprietary; the image is public). Only its pin is baked
# in, for the user-initiated `lab-ai install-claude-code` (CONTRACT Phase 5).
ARG CLAUDE_CODE_VERSION
ARG CLAUDE_CODE_SHA256_LINUX_X64
ARG CLAUDE_CODE_SHA256_LINUX_ARM64
# MCP servers (Phase 5, mcp/): the official dbt-mcp, the MCP SDK and the SQL parser.
ARG DBT_MCP_VERSION
ARG MCP_SDK_VERSION
ARG SQLGLOT_VERSION

ENV NB_USER=jovyan NB_UID=1000 NB_GID=100 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DUCKDB_EXT_DIR=/opt/duckdb/extensions \
    SHELL=/bin/bash \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false DO_NOT_TRACK=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True LITELLM_TELEMETRY=False \
    LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false

RUN --mount=type=bind,source=scripts/install-os.sh,target=/tmp/install-os.sh \
    bash /tmp/install-os.sh

# code-server: official release tarball (bundles its own node), pinned by CODE_SERVER_VERSION.
RUN --mount=type=bind,source=scripts/install-code-server.sh,target=/tmp/install-code-server.sh \
    bash /tmp/install-code-server.sh "${CODE_SERVER_VERSION}"

# Python packages. requirements.in holds ${VAR} refs that pip expands from the build args;
# lock/constraints.txt (GENERATED by relock.sh) pins every transitive dependency.
COPY requirements.in lock/constraints.txt /tmp/req/
RUN pip install -r /tmp/req/requirements.in -c /tmp/req/constraints.txt \
 && pip check \
 && rm -rf /tmp/req

# DuckDB extensions baked into a shared directory (not $HOME, which JupyterHub mounts over).
COPY scripts/install-duckdb-extensions.py /usr/local/lib/lakehouse/install-duckdb-extensions.py
RUN python /usr/local/lib/lakehouse/install-duckdb-extensions.py

# Pre-wired clients. `lakehouse` (lab_token(), trino/duckdb/pyiceberg/spark helpers) is the ONE
# place clients get the user's token; /opt/lakehouse/bin holds `lab-token`, the `dbt` shim
# that hands dbt-trino a fresh token, and `lab-tracks` (learning tracks: list/check/reset).
# PyIceberg reads /etc/lakehouse/pyiceberg/.pyiceberg.yaml.
COPY lakehouse/ /opt/lakehouse/python/lakehouse/
COPY bin/ /opt/lakehouse/bin/
# Entry point `jupyter_ai.personas` -> lakehouse.ai_persona:LabAssistant (the package itself is
# not pip-installed; importlib.metadata finds this dist-info on PYTHONPATH).
COPY dist-info/ /opt/lakehouse/python/
COPY etc/pyiceberg/ /etc/lakehouse/pyiceberg/
# Login shells (JupyterLab terminals run `bash -l`): /etc/profile resets PATH, so this puts
# /opt/lakehouse/bin first again (the ENV PATH below only reaches non-login processes).
COPY etc/profile.d/lakehouse.sh /etc/profile.d/lakehouse.sh
COPY config/jupyter_server_config.py /etc/jupyter/jupyter_server_config.py
COPY scripts/start-workspace.sh /usr/local/bin/start-workspace.sh
# Starter dbt project + README notebook, copied into a new user's home on first start.
COPY --from=starter . /opt/lakehouse/starter/
# Learning tracks (v3/tracks, named build context `tracks`): the pristine lessons. Every start
# copies what is new into ~/tracks without overwriting the learner's edits (`lab-tracks sync`,
# lakehouse/tracks.py); `lab-tracks reset` restores a module from here.
COPY --from=tracks . /opt/lakehouse/tracks/
RUN mkdir -p /opt/lakehouse/etc \
 && python -c 'import json, os, sys; json.dump({"claude_code": {"version": os.environ["CLAUDE_CODE_VERSION"], "sha256": {"linux-x64": os.environ["CLAUDE_CODE_SHA256_LINUX_X64"], "linux-arm64": os.environ["CLAUDE_CODE_SHA256_LINUX_ARM64"]}}}, sys.stdout, indent=1)' >/opt/lakehouse/etc/ai.json \
 && chmod 0755 /opt/lakehouse/bin/* /usr/local/bin/start-workspace.sh \
 && chmod 0644 /etc/profile.d/lakehouse.sh \
 && chmod -R a+rX,go-w /opt/lakehouse/tracks \
 && python -m compileall -q /opt/lakehouse/python

# The lab's MCP servers (CONTRACT Phase 5; mcp/README.md): lab-trino, lab-context and dbt-mcp,
# started by `lab-mcp` as the user. Their own venv (/opt/lakehouse/mcp/venv), so dbt-mcp's exact
# pins never change the notebook environment. Versions: build args (versions.env).
RUN --mount=type=bind,source=mcp,target=/tmp/mcp \
    bash /tmp/mcp/install.sh

ENV PYTHONPATH=/opt/lakehouse/python \
    PATH=/opt/lakehouse/bin:$PATH:/home/jovyan/.local/bin \
    PYICEBERG_HOME=/etc/lakehouse/pyiceberg

USER ${NB_UID}
WORKDIR /home/${NB_USER}
EXPOSE 8888
# The wiring script is the ENTRYPOINT (not the CMD), so it still runs when a spawner
# overrides cmd. An empty CMD means "pick the server": jupyterhub-singleuser under
# JupyterHub, jupyter lab otherwise. The hub config must never override the entrypoint.
ENTRYPOINT ["tini", "-g", "--", "/usr/local/bin/start-workspace.sh"]
CMD []
