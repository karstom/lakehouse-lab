# Lakehouse Lab ai-gateway: the LiteLLM proxy (CONTRACT Phase 5, OQ-7), built from PyPI.
#
# Why not the upstream image: it ships LiteLLM's `enterprise/` code and the `litellm-enterprise`
# package, which are proprietary (no redistribution, production use needs a subscription). This
# image is public (v3-images.yml), so it carries ONLY the MIT-licensed LiteLLM code:
# lock/requirements.txt (GENERATED by relock.sh) is the full package set without
# litellm-enterprise, installed with --no-deps; verify.py fails the build if any proprietary
# package or module is present. OSS features used are listed in config/ai/README.md.
#
# Prisma (LiteLLM's DB layer): the client and engines are generated at build time under
# /opt/prisma, and the container runs with PRISMA_OFFLINE_MODE=true (no runtime download).
# Pins: versions.env only (ADR-012). Build context: images/ai-gateway; the lab's start script,
# config renderer and hooks come from the named context `config` (config/ai), baked in so an
# upgrade (install.sh: up --build) always runs the new files.
ARG PYTHON_IMAGE_TAG
ARG PYTHON_IMAGE_DIGEST

FROM python:${PYTHON_IMAGE_TAG}@${PYTHON_IMAGE_DIGEST} AS builder
ARG LITELLM_VERSION
ARG PRISMA_PYTHON_VERSION
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# node + npm: the Prisma CLI is a node program; `prisma generate` installs it and the engines.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*
COPY lock/requirements.txt /tmp/req/requirements.txt
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-deps -r /tmp/req/requirements.txt \
 && /opt/venv/bin/pip check
COPY verify.py /tmp/verify.py
RUN /opt/venv/bin/python /tmp/verify.py "$LITELLM_VERSION" "$PRISMA_PYTHON_VERSION" builder
# Generate the prisma client from LiteLLM's schema, with the CLI and engines under /opt/prisma.
RUN schema=$(/opt/venv/bin/python -c 'import litellm, os; print(os.path.join(os.path.dirname(litellm.__file__), "proxy", "schema.prisma"))') \
 && HOME=/opt/prisma XDG_CACHE_HOME=/opt/prisma/.cache PRISMA_BINARY_CACHE_DIR=/opt/prisma/binaries \
    npm_config_cache=/tmp/npm PATH="/opt/venv/bin:$PATH" \
    prisma generate --schema="$schema" \
 && rm -rf /tmp/npm

FROM python:${PYTHON_IMAGE_TAG}@${PYTHON_IMAGE_DIGEST} AS runtime
ARG LITELLM_VERSION
ARG PRISMA_PYTHON_VERSION
# node (no npm) runs the Prisma CLI for `prisma migrate deploy` at start.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 litellm \
 && useradd --uid 1000 --gid 1000 --home-dir /home/litellm --create-home --shell /usr/sbin/nologin litellm
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/prisma /opt/prisma
# No outbound calls LiteLLM would make on its own (Phase 5 contract): the bundled model cost
# map, Anthropic beta-header map and autorouter presets instead of fetching them from GitHub;
# no admin UI, no Swagger docs; telemetry off (also `litellm_settings.telemetry: false`).
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HOME=/home/litellm \
    PRISMA_BINARY_CACHE_DIR=/opt/prisma/binaries \
    PRISMA_CLI_PATH=/opt/prisma/binaries/node_modules/.bin/prisma \
    PRISMA_CLI_QUERY_ENGINE_TYPE=binary \
    PRISMA_OFFLINE_MODE=true \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    CHECKPOINT_DISABLE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    LITELLM_LOCAL_ANTHROPIC_BETA_HEADERS=True \
    LITELLM_LOCAL_AUTOROUTER_PRESETS=True \
    DISABLE_ADMIN_UI=True \
    NO_DOCS=True \
    NO_REDOC=True
COPY verify.py /tmp/verify.py
RUN chmod -R a+rX /opt/prisma \
 && test -x /opt/prisma/binaries/node_modules/.bin/prisma \
 && python /tmp/verify.py "$LITELLM_VERSION" "$PRISMA_PYTHON_VERSION" runtime \
 && rm /tmp/verify.py
COPY --from=config --chown=root:root start.sh render_config.py lab_hooks.py /opt/lab/ai/
RUN chmod 0755 /opt/lab/ai/start.sh
USER litellm
WORKDIR /home/litellm
EXPOSE 4000
ENTRYPOINT ["/opt/lab/ai/start.sh"]
