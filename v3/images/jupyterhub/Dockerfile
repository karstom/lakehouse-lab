# JupyterHub for Lakehouse Lab (CONTRACT Phase 2): the upstream hub image (JupyterHub plus
# configurable-http-proxy) + OAuthenticator + DockerSpawner. Pins: versions.env only
# (ADR-012); transitive pins: lock/constraints.txt (GENERATED by relock.sh). The config is
# mounted from config/jupyterhub/, not baked in.
ARG JUPYTERHUB_VERSION
ARG JUPYTERHUB_IMAGE_DIGEST
FROM quay.io/jupyterhub/jupyterhub:${JUPYTERHUB_VERSION}@${JUPYTERHUB_IMAGE_DIGEST}
ARG JUPYTERHUB_VERSION
ARG OAUTHENTICATOR_VERSION
ARG DOCKERSPAWNER_VERSION
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1
COPY requirements.in lock/constraints.txt /tmp/req/
RUN pip install -r /tmp/req/requirements.in -c /tmp/req/constraints.txt \
 && pip check \
 && rm -rf /tmp/req
WORKDIR /srv/jupyterhub
CMD ["jupyterhub", "-f", "/etc/jupyterhub/jupyterhub_config.py"]
