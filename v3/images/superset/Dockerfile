# Superset for Lakehouse Lab (CONTRACT Phase 3, profile `full`; ADR-009).
# The upstream lean image by tag and digest, plus what it leaves out (S-3): authlib (FAB OAuth),
# psycopg2 (metadata DB in the shared Postgres) and the Trino driver. Everything is installed at
# build time into Superset's own venv; nothing is installed at runtime (REG_SUPERSET_SETUP).
# Pins: versions.env only (ADR-012); transitive pins: lock/constraints.txt (GENERATED by relock.sh).
# The lab's config, start script and bundled dashboard come from config/superset (build
# context `config`), so an upgrade (install.sh: up --build) always runs the new files.
ARG SUPERSET_VERSION
ARG SUPERSET_IMAGE_DIGEST
FROM apache/superset:${SUPERSET_VERSION}@${SUPERSET_IMAGE_DIGEST}
ARG SUPERSET_VERSION
ARG AUTHLIB_VERSION
ARG PSYCOPG2_BINARY_VERSION
ARG TRINO_PYTHON_VERSION
USER root
COPY requirements.in lock/constraints.txt /tmp/req/
# uv does not expand ${VARS} in requirement versions (pip does), so expand them first.
RUN python3 -c 'import os,sys; sys.stdout.write(os.path.expandvars(open(sys.argv[1]).read()))' \
      /tmp/req/requirements.in >/tmp/req/requirements.txt \
 && uv pip install --no-cache --python /app/.venv/bin/python \
      -r /tmp/req/requirements.txt -c /tmp/req/constraints.txt \
 && uv pip check --python /app/.venv/bin/python \
 && rm -rf /tmp/req
COPY --from=config --chown=root:root superset_config.py lab_trino.py /app/pythonpath/
COPY --from=config --chown=root:root start.sh lab_init.py /app/lakehouse/
COPY --from=config --chown=root:root dashboards /app/lakehouse/dashboards
RUN chmod 0755 /app/lakehouse/start.sh
USER superset
ENTRYPOINT ["/app/lakehouse/start.sh"]
