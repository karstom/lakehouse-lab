# Lakehouse Lab V3 — the ONLY file where versions are written (ADR-012).
# Everything else references these as ${VAR} / build ARGs. Generated lockfiles
# (header "# GENERATED") are derived from this file and exempt (ADR-012 amendment).

# Storage / catalog
SEAWEEDFS_VERSION=4.47
LAKEKEEPER_VERSION=v0.13.6
OPENFGA_VERSION=v1.21.0
POSTGRES_VERSION=17.11

# Engines (Spark 4.2 has no Iceberg runtime yet -> 4.1)
SPARK_VERSION=4.1.3
SPARK_IMAGE_TAG=4.1.3-scala2.13-java17-python3-ubuntu
# Multi-arch index digest of apache/spark:${SPARK_IMAGE_TAG} (the Spark image copies its JDK and
# /opt/spark from it onto the workspace's Python base, so Python UDF minors match).
SPARK_IMAGE_DIGEST=sha256:9b0a6c2c860f5e7d18dd5270286fef32a09c7f5a7e2b0dbe5642de8a3a02ab3e
SCALA_BINARY_VERSION=2.13
ICEBERG_VERSION=1.11.0
# sha256 of the Iceberg jars baked into the Spark image. Change together with ICEBERG_VERSION.
ICEBERG_SPARK_RUNTIME_DIGEST=sha256:d6ea6c5d099288daeb7d5a92061bd3d7d8f296492632b42378e5f2f0e3066242
ICEBERG_AWS_BUNDLE_DIGEST=sha256:38f01da7e96850cdd05e6616d758b77b43314b712a8808e3f9a824d56976162f
TRINO_VERSION=483

# Identity / edge
KEYCLOAK_VERSION=26.7.4
CADDY_VERSION=2.11.4

# Orchestration / BI / workspace
AIRFLOW_VERSION=3.3.2
AIRFLOW_PYTHON=3.12
# Multi-arch index digest of apache/airflow:${AIRFLOW_VERSION}-python${AIRFLOW_PYTHON}.
AIRFLOW_IMAGE_DIGEST=sha256:9df9c8be4096b9cc626bd7cb1f2b8c712eef66c59c615f8c7e6200871ca10bd1
# papermill in the Airflow jobs venv (lab_notebook DAG, ADR-009).
PAPERMILL_VERSION=2.7.0
SUPERSET_VERSION=6.1.0
# Superset base image apache/superset:${SUPERSET_VERSION} (multi-arch index digest).
SUPERSET_IMAGE_DIGEST=sha256:16b50bbef6648912a79e3293d418fefa743ce555d36c5af6b85d859119ed7f88
# Forward-auth for the Console and the Spark UI (Keycloak client `console`). The -alpine
# variant has wget for the healthcheck; the distroless default has no shell tools.
OAUTH2_PROXY_IMAGE_TAG=v7.15.4-alpine
OAUTH2_PROXY_IMAGE_DIGEST=sha256:77a608f6da587bda7fe1371c503dc89b39d0fb9d78dc3d47c1ef253abfc9d2bd
JUPYTERHUB_VERSION=5.5.2
# Upstream hub image quay.io/jupyterhub/jupyterhub:${JUPYTERHUB_VERSION} by digest.
JUPYTERHUB_IMAGE_DIGEST=sha256:1c38e6f0178c49b7b5fde7f119596a6fc8aecd66dc304403f5c1f25cfd843b5a
DOCKERSPAWNER_VERSION=14.0.0
# DockerSpawner never sees /var/run/docker.sock directly: it talks to this proxy (CONTRACT Phase 2).
DOCKER_SOCKET_PROXY_IMAGE_TAG=v0.5.0
DOCKER_SOCKET_PROXY_IMAGE_DIGEST=sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459

# Base images (tag + digest, ADR-012)
PYTHON_IMAGE_TAG=3.12.14-slim-bookworm
PYTHON_IMAGE_DIGEST=sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

# Identity integrations
OAUTHENTICATOR_VERSION=17.4.0
AIRFLOW_PROVIDERS_KEYCLOAK_VERSION=0.10.0
AUTHLIB_VERSION=1.8.0
PSYCOPG2_BINARY_VERSION=2.9.9

# Python clients (workspace image)
PYSPARK_VERSION=4.1.3
DUCKDB_VERSION=1.5.5
PYICEBERG_VERSION=0.12.0
TRINO_PYTHON_VERSION=0.340.0
DBT_CORE_VERSION=1.12.5
DBT_TRINO_VERSION=1.10.5
JUPYTERLAB_VERSION=4.6.4
# ipykernel held on the 6.x line: 7.x (7.3.0 measured) sometimes leaves a shell message that
# arrives right after kernel start unprocessed until the NEXT shell message from another peer,
# so a notebook's first cell can hang forever with the kernel idle
# (REG_V3_WORKSPACE_KERNEL_FIRST_MESSAGE_STALL). Revisit when a 7.x release fixes it; repro:
# tests/smoke/kernel-loop.sh --race or tools/kernel_ws_race.py.
IPYKERNEL_VERSION=6.31.0
JUPYTER_AI_VERSION=3.2.0
JUPYTER_SERVER_PROXY_VERSION=4.6.0
CODE_SERVER_VERSION=4.138.0
JUPYSQL_VERSION=0.11.1
JUPYTERLAB_GIT_VERSION=0.54.1
# pandas on the Spark workers (pandas UDFs); equal to the workspace lock's pandas.
PANDAS_VERSION=3.0.6

# Test tooling (smoke image: Playwright base + PyIceberg; pyarrow matches the S-4 lock)
PLAYWRIGHT_VERSION=1.63.0
PLAYWRIGHT_IMAGE_TAG=v1.63.0-noble
PLAYWRIGHT_IMAGE_DIGEST=sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
PYARROW_VERSION=25.0.1

# CI linters, run from pinned containers (tag + digest) so local runs match CI.
# ShellCheck is used by v3/tools/shellcheck.sh and v3/tests/installer/run.sh.
ACTIONLINT_IMAGE_TAG=1.7.12
ACTIONLINT_IMAGE_DIGEST=sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
SHELLCHECK_IMAGE_TAG=v0.11.0
SHELLCHECK_IMAGE_DIGEST=sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
